{
  "expo": {
    "name": "HereO",
    "slug": "hereo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hereo",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "app.hereo",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "HereO shares your location with the people helping you while a help request is open, and finds heroes near you.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "HereO uses your location in the background during a trip, so your circle can follow until you arrive, and while you're available as a hero, so it can send you to someone nearby. Nobody else sees where you are.",
        "UIBackgroundModes": [
          "location",
          "remote-notification",
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.hereo",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "VIBRATE"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HereO shares your location with the people helping you while a help request is open, and finds heroes near you.",
          "locationAlwaysAndWhenInUsePermission": "HereO uses your location in the background during a trip, so your circle can follow until you arrive, and while you're available as a hero, so it can send you to someone nearby. Nobody else sees where you are.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E8338B",
          "sounds": [
            "./assets/sounds/hereo-ring.wav"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "HereO records a few seconds of what you say when you ask it to, so the people helping you know what's happening. Recordings are transcribed and not kept.",
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "app.hereo.widgets",
          "groupIdentifier": "group.app.hereo",
          "widgets": [
            {
              "name": "StartTrip",
              "displayName": "Start a trip",
              "description": "Start a walk, run or ride your circle follows, in one tap.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ]
            }
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HereO lets you share a photo of where you are with the people helping you. Faces and number plates are blurred first.",
          "cameraPermission": "HereO lets you take a photo of where you are for the people helping you. Faces and number plates are blurred first.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "app.hereo.widgets",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.app.hereo"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "02bef9ac-4d9d-4d0f-9d57-22144893d058"
      }
    },
    "owner": "jclift3"
  }
}
